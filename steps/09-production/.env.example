# Copy to .env.local and edit. .env.local is git-ignored (*.local).
# Everything VITE_* is PUBLIC: it is bundled into the JS the browser downloads. No secrets here.

# Real backend. Leave empty to use the MSW mock API.
VITE_API_URL=

# Browser tab title suffix
VITE_APP_TITLE=Task Board

# Print error reports to the console (production would send them to Sentry etc.)
VITE_LOG_ERRORS=true
