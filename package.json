{
  "name": "learning-vue",
  "private": true,
  "description": "Learn Vue 3 from basics to production, one step per folder",
  "workspaces": [
    "steps/*"
  ],
  "scripts": {
    "dev:01": "npm run dev -w steps/01-reactivity",
    "test:01": "npm run test:unit -w steps/01-reactivity -- --run",
    "dev:02": "npm run dev -w steps/02-components",
    "test:02": "npm run test:unit -w steps/02-components -- --run",
    "test": "npm run test:unit --workspaces -- --run",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
