{
  "name": "learning-vue",
  "private": true,
  "description": "Learn Vue 3 from basics to production, one step per folder",
  "workspaces": [
    "steps/*"
  ],
  "scripts": {
    "dev:01": "npm run dev -w steps/01-reactivity",
    "test:01": "npm run test:unit -w steps/01-reactivity -- --run",
    "dev:02": "npm run dev -w steps/02-components",
    "test:02": "npm run test:unit -w steps/02-components -- --run",
    "dev:03": "npm run dev -w steps/03-composables",
    "test:03": "npm run test:unit -w steps/03-composables -- --run",
    "dev:04": "npm run dev -w steps/04-router",
    "test:04": "npm run test:unit -w steps/04-router -- --run",
    "dev:05": "npm run dev -w steps/05-pinia",
    "test:05": "npm run test:unit -w steps/05-pinia -- --run",
    "dev:06": "npm run dev -w steps/06-forms",
    "test:06": "npm run test:unit -w steps/06-forms -- --run",
    "dev:07": "npm run dev -w steps/07-api",
    "test:07": "npm run test:unit -w steps/07-api -- --run",
    "dev:08": "npm run dev -w steps/08-testing",
    "test:08": "npm run test:unit -w steps/08-testing -- --run",
    "test:e2e:08": "npm run test:e2e -w steps/08-testing",
    "dev:09": "npm run dev -w steps/09-production",
    "test:09": "npm run test:unit -w steps/09-production -- --run",
    "test:e2e:09": "npm run test:e2e -w steps/09-production",
    "test": "npm run test:unit --workspaces -- --run",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "dev": "npm run dev:09"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
